# Copy to .env (gitignored): `cp .env.example .env`. tools/dev.sh does this for you on first start.
# Local development reads it through spring.config.import (backend/src/main/resources/application.yml).
# The values below are for your LOCAL dev database only. Production uses deploy/.env (see deploy/.env.example).

# First admin, created on startup while no admin exists (FR-003). Must change the password at first sign-in.
ADMIN_EMAIL=admin@fotozielnik.local
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

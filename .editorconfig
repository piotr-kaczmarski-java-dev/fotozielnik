root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kts,gradle,sql,sh}]
indent_size = 4

[*.java]
# Formatting is owned by Spotless (palantir-java-format): run tools/check.sh backend --fix.
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

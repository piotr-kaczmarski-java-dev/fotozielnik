{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SPRING_MAIN_BANNER_MODE": "off"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(tools/check.sh*)",
      "Bash(tools/test.sh*)",
      "Bash(tools/look.sh*)",
      "Bash(tools/lint-repo.sh*)",
      "Bash(tools/dev.sh status)",
      "Bash(tools/dev.sh up)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(curl -s http://localhost:5173/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.sh\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.sh\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh\"",
            "timeout": 300,
            "statusMessage": "Static check of changed code (compile, NullAway, format, typecheck, lint)..."
          }
        ]
      }
    ]
  }
}

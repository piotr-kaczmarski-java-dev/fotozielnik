# Production settings: copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32

DOMAIN=fotozielnik.pl

POSTGRES_PASSWORD=                         # openssl rand -hex 32

# Garage S3 (only reachable inside the compose network)
GARAGE_RPC_SECRET=                         # openssl rand -hex 32
GARAGE_ACCESS_KEY_ID=                      # "GK" + openssl rand -hex 12
GARAGE_SECRET_ACCESS_KEY=                  # openssl rand -hex 32
PHOTOS_DIR=/mnt/photos/garage              # on the large volume; default: a Docker volume
GARAGE_CAPACITY=500G

# First admin (created only while no admin exists; must change the password at first sign-in)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Optional tuning
APP_MEMORY=6g
JOB_WORKERS=0                              # 0 = cores - 1

# Backups (backup.sh): an rclone remote for off-site copies, e.g. "offsite:fotozielnik-backup"
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
RCLONE_CONFIG_DIR=/root/.config/rclone     # where `rclone config` saved the remote
